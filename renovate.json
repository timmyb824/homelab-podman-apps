{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Never auto-bump MySQL across major versions (needs a manual dump/upgrade)",
      "matchPackageNames": ["docker.io/mysql", "mysql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "includePaths": [
    "gitops/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  }
}
